{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyNexus Connector",
  "version": "0.1.0",
  "identifier": "nl.skynexus.connector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Streams your simulator aircraft to your SkyNexus map",
    "longDescription": "An optional tray app that reads your own aircraft and nearby traffic from MSFS or X-Plane on this computer and streams it to your SkyNexus enroute map. Outbound connections only; nothing is installed in the simulator. It can start and stop with MSFS through its own entry in MSFS's add-on list (exe.xml), which uninstalling removes.",
    "copyright": "SkyNexus",
    "licenseFile": "windows/installer-notice.txt",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRTAxREI2NDM3RTlFNzUKUldSMW5uNUR0aDNnYXp3L3FJcEpJc0xqOFhzUnJ1YWhZbjVyVStqK00rYzltYWovUjFQbEdiNjgK",
      "endpoints": [
        "https://github.com/JoeriSmits/skynexus-connector/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
